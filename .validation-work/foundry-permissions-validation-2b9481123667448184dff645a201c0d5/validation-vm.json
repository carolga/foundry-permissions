      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "metadata": {
        "description": "Object ID of the current operator user. Supply ephemerally for VM-scoped login authorization; never persist it."
      }
    },
    "validationVmShutdownTime": {
      "type": "string",
      "defaultValue": "1900",
