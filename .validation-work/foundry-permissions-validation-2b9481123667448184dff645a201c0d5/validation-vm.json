      "type": "string",
      "defaultValue": "northcentralus",
      "allowedValues": [
        "northcentralus"
      ],
      "metadata": {
        "description": "Azure region for the private validation VM."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Additional approved non-PII tags. Locked governance tags are applied after this object."
      }
    },
