# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Azure Developer CLI local environment state
.azure/*/.env
.azure/config.json

# Local validation/build artifacts
.validation-work/
.validation-review-vm/
infra/environments/validation.*.bicepparam
!infra/environments/validation.bicepparam.example

# Terraform provider cache, state, saved plans, and local deployment values
**/.terraform/
**/terraform.tfstate*
**/*.tfplan
**/*.tfvars
**/*.tfvars.json
**/crash.log
infra/terraform/**/__pycache__/
