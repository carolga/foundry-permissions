        <mxCell id="bastion" value="&lt;b&gt;Azure Bastion (optional)&lt;/b&gt;&lt;br&gt;Public IP for HTTPS; Standard with Windows&lt;br&gt;Basic for Linux-only setup" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=13;dashed=1;" vertex="1" parent="1">
