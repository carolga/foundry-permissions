          <mxGeometry x="40" y="24" width="1460" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Standard Agent Setup with a dedicated virtual network and new or existing backing services | West US 3 example" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="73" width="1460" height="26" as="geometry"/>
