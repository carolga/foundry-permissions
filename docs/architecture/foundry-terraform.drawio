<mxfile host="app.diagrams.net">
  <diagram id="foundry-terraform" name="Private Foundry - Terraform">
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
