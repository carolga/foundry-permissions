        <mxCell id="dns" value="&lt;b&gt;Azure Private DNS&lt;/b&gt; | Six VNet-linked zones; records managed through private endpoint zone groups&lt;br&gt;cognitiveservices, openai, services.ai, blob, documents (Cosmos DB), and search" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F0F9FF;strokeColor=#7DD3FC;fontSize=13;" vertex="1" parent="1">
