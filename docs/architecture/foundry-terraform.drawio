        </mxCell>
        <mxCell id="cosmos" value="&lt;b&gt;Azure Cosmos DB for NoSQL&lt;/b&gt;  |  Thread storage" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6EE7B7;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="999" y="478" width="460" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="search" value="&lt;b&gt;Azure AI Search&lt;/b&gt;  |  Vector store for file search" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#6EE7B7;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="999" y="545" width="460" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="stores-note" value="Public access disabled on all three stores.&lt;br&gt;Separate deployment option: infra/terraform/backing-stores&lt;br&gt;Existing stores may reside in another resource group." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="999" y="615" width="460" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="bindings" value="LOGICAL CONFIGURATION  |  Project capability host: agents" style="rounded=1;arcSize=7;html=1;fillColor=#F5F3FF;strokeColor=#A78BFA;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=15;fontStyle=1;fontColor=#4C1D95;" vertex="1" parent="1">
          <mxGeometry x="230" y="750" width="1270" height="162" as="geometry"/>
        </mxCell>
        <mxCell id="binding-note" value="The host references these project connection names, not resource IDs. Each connection points to its backing resource and uses Microsoft Entra ID; the project identity receives scoped RBAC." style="text;html=1;whiteSpace=wrap;align=left;fontSize=13;fontColor=#4C1D95;" vertex="1" parent="1">
