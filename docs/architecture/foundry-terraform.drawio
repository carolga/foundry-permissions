        <mxCell id="legend" value="Dashed boxes: optional components/subnets.  |  Blue arrows: private traffic / Private Link.  |  Capability-host path, not capabilitySettings. No DR." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;" vertex="1" parent="1">
