        </mxCell>
        <mxCell id="vms" value="&lt;b&gt;Private validation VMs (optional)&lt;/b&gt;&lt;br&gt;Windows desktop: RDP, Entra login extension&lt;br&gt;Linux jumpbox: SSH / validation scripts&lt;br&gt;No public IPs; VM identities have project access" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=13;dashed=1;" vertex="1" parent="1">
